# Local defaults work without this file or an AI API key.
CIRCUITPILOT_ENVIRONMENT=development
CIRCUITPILOT_DATABASE_URL=sqlite:///./data/circuitpilot.db
CIRCUITPILOT_STORAGE_DIR=data/uploads
CIRCUITPILOT_AUTO_CREATE_SCHEMA=true
CIRCUITPILOT_COOKIE_SECURE=false
CIRCUITPILOT_ALLOWED_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:8000"]
CIRCUITPILOT_PHOTO_RETENTION_DAYS=30
CIRCUITPILOT_MAX_UPLOAD_BYTES=10485760
CIRCUITPILOT_SESSION_HOURS=24
# Configure only after supplying trusted evaluated weights and the optional runtime.
# CIRCUITPILOT_DETECTOR_MODEL_DIR=ml/runs/experiment-001
# Docker requires a strong password. Do not use this placeholder.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Frontend build/start setting, normally provided by Compose or scripts/dev.py.
# CIRCUITPILOT_API_URL=http://127.0.0.1:8000
