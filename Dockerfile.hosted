FROM node:24-bookworm-slim AS web-build
WORKDIR /web
RUN npm install --global pnpm@11.25.0
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend ./
ENV CIRCUITPILOT_API_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.12.5 /uv /uvx /bin/
COPY --from=web-build /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 libgomp1 libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home circuitpilot
WORKDIR /app
COPY pyproject.toml uv.lock alembic.ini ./
COPY backend ./backend
RUN uv sync --locked --no-dev --no-editable \
    && node --version && .venv/bin/python -c "import cv2, app.hosted"
COPY --from=web-build --chown=circuitpilot:circuitpilot /web/.next/standalone ./web
COPY --from=web-build --chown=circuitpilot:circuitpilot /web/.next/static ./web/.next/static
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1 PORT=10000
# The entrypoint initializes only /var/data/uploads, then drops root before
# migrations or network processes. Node and Python use the same Debian ABI.
EXPOSE 10000
HEALTHCHECK --interval=10s --timeout=15s --start-period=40s --retries=3 CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.environ['PORT']+'/api/v1/health/ready',timeout=12)"
CMD ["python", "-m", "app.hosted"]
